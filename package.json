{
  "name": "html-text-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Визуальный редактор текста и данных графиков в HTML",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx server.ts --dev",
    "build": "tsc --noEmit && node sites/build.mjs",
    "start": "node --import tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.3",
    "acorn": "8.19.0",
    "lucide-react": "0.477.0",
    "parse5": "8.0.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "superjson": "2.2.2",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}

